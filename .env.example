# Copy this file to .env and fill in real values.
# Every setting below has a safe default in core/settings.py for local dev,
# so the app runs with ZERO of these set — SQLite + console email out of the box.

# --- Core ---
SECRET_KEY=change-me-to-a-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave blank to use local SQLite. On Render/Railway, this is injected automatically
# when you attach a Postgres addon — you usually don't need to set it by hand.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- Email ---
# Default (blank) uses Django's console backend — emails print to your terminal.
# For real delivery, e.g. SendGrid SMTP:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=clinic@example.com
EMAIL_TIMEOUT=10

# --- LLM (pre-visit / post-visit summaries) ---
# Without this, the app still works fully — summaries just show a graceful
# fallback message and urgency defaults to "Medium" (see aiservice/services.py).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Google Calendar ---
# See README "Google Calendar Setup" section for how to obtain these.
# Without these, calendar events are simply skipped — booking/email still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback/

# --- App tuning ---
SLOT_HOLD_MINUTES=5
